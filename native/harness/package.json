{
  "name": "@local/personal-workbench",
  "version": "0.1.1",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@quartz-community/remark-obsidian": "2.2.1",
    "fflate": "0.8.3",
    "jose": "6.2.17",
    "p-queue": "10.0.0",
    "pdfjs-dist": "6.5.438",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1"
  },
  "type": "module",
  "description": "Personal workbench with MySQL resources and durable tasks",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "model-capacity.js",
    "tool-namespace.js",
    "delivery-state.js",
    "attachment-text.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "NOTICE",
    "personal-memory.js",
    "superagent.js",
    "superagent-delivery.js",
    "SUPERAGENT-LICENSE",
    "owner-catalog.js",
    "reply-evidence.js",
    "channel-context.js",
    "resource-documents.js",
    "library-command.js",
    "vault-markdown.js",
    "vault-editor.bundle.js",
    "vault-editor.LICENSES.txt",
    "OBSIDIAN-WEB-GATEWAY.LICENSE.txt",
    "model-options.js",
    "activation.js",
    "activation-issuer.js",
    "brand.png",
    "brand-192.png",
    "brand-512.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
