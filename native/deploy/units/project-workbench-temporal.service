[Unit]
Description=Personal Workbench native temporal
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=projectwb
Group=projectwb
WorkingDirectory=/opt/project-workbench/current
Environment=HOME=/home/projectwb
ExecStart=/usr/bin/python3 /opt/project-workbench/current/deploy/start.py temporal
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillMode=control-group
UMask=0077
MemoryMax=1000M
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
