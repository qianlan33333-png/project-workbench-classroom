[Unit]
Description=Project Workbench WeChat and Feishu transport
After=network-online.target project-workbench.service
Requires=project-workbench.service
Conflicts=workbench-wechat.service workbench-feishu.service deepseek-harness.service

[Service]
Type=simple
User=projectwb
Group=projectwb
WorkingDirectory=/opt/project-workbench/current/runtime
Environment=WORKBENCH_CHANNEL_CONFIG=/etc/project-workbench/channels.json
Environment=HOME=/home/projectwb
ExecStart=/opt/project-workbench/current/node/bin/node /opt/project-workbench/current/runtime/channels.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
