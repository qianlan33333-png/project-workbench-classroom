# Minimal standalone workbench host. Merge into an existing site; preserve its other routes.
workbench.example.com {
    # Keep live SSE outside compression, including on older Caddy versions.
    @workbench_compressible {
        not {
            path /api/v1/events /next/api/v1/events
            header Accept *text/event-stream*
        }
    }
    encode @workbench_compressible zstd gzip
    reverse_proxy 127.0.0.1:3082
}
