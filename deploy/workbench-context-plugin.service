[Unit]
Description=Independent workbench context and batch tool plugin
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
User=projectwb
Group=projectwb
ExecStart=/opt/workbench-context-plugin/current/tool-plugin -config /var/lib/workbench-context-plugin/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/workbench-context-plugin
UMask=0077
MemoryMax=768M
TasksMax=128

[Install]
WantedBy=multi-user.target
