[Unit]
Description=Personal Project Workbench (igo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=projectwb
Group=projectwb
WorkingDirectory=/opt/project-workbench/current
Environment=HOME=/home/projectwb
Environment=PATH=/opt/project-workbench/current/node/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/project-workbench/service.env
ExecStartPre=-/usr/bin/systemctl --user stop project-workbench-runtime.service
ExecStart=/usr/bin/systemd-run --user --wait --pipe --collect --unit=project-workbench-runtime --property=Delegate=yes --property=KillMode=control-group --property=TimeoutStopSec=60 --working-directory=/opt/project-workbench/current --setenv=HOME=/home/projectwb --setenv=PATH=/opt/project-workbench/current/node/bin:/usr/local/bin:/usr/bin:/bin /opt/project-workbench/current/bin/workbench -config /etc/project-workbench/config.json
ExecStop=/usr/bin/systemctl --user stop project-workbench-runtime.service
Restart=on-failure
RestartSec=3
TimeoutStopSec=60
KillMode=control-group
Delegate=yes
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
