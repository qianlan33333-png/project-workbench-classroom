FROM public.ecr.aws/docker/library/debian@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3
ARG APT_MIRROR=deb.debian.org
RUN sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git bash python3 python3-pip python3-venv build-essential musl-tools ripgrep jq chromium xvfb x11vnc novnc websockify tini poppler-utils tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
COPY node /opt/node
ENV PATH=/opt/node/bin:$PATH
COPY harness /opt/harness
COPY native-linux /opt/harness/native-packages/linux-x64
COPY native-src /tmp/native-src
RUN mkdir -p /opt/harness/native-packages/linux-x64/bin/glibc /opt/harness/native-packages/linux-x64/bin/musl && \
    cc -std=c11 -O2 -Wall -Wextra -Werror -fPIC -fvisibility=hidden -DNAPI_VERSION=8 -I /opt/node/include/node -shared /tmp/native-src/flock.c -o /opt/harness/native-packages/linux-x64/bin/glibc/system.node && \
    musl-gcc -std=c11 -Os -Wall -Wextra -Werror -static -s /tmp/native-src/main.c -o /opt/harness/native-packages/linux-x64/bin/landlock-run && \
    rm -rf /tmp/native-src
COPY runtime /opt/workbench-runtime
COPY entrypoint.sh /usr/local/bin/workbench-entrypoint
RUN chmod +x /usr/local/bin/workbench-entrypoint && ln -s /opt/harness/lib/bin.js /opt/node/bin/dsh && dsh --version
ENV NODE_ENV=production PW_CHROMIUM=/usr/bin/chromium
WORKDIR /workspace
RUN test -e /opt/harness/node_modules/node-addon-native-custom-loader || ln -s .pnpm/node-addon-native-custom-loader@0.1.9/node_modules/node-addon-native-custom-loader /opt/harness/node_modules/node-addon-native-custom-loader
RUN DSH_HOME=/tmp/build-check HOME=/tmp/build-check dsh --profile sdk </dev/null && rm -rf /tmp/build-check
ENTRYPOINT ["/usr/bin/tini","-g","--","/usr/local/bin/workbench-entrypoint"]
